// ─── Platform / Auth models ───────────────────────────────────────────────────

model Tenant {
  id            String             @id @default(cuid())
  slug          String             @unique
  status        TenantStatus       @default(ACTIVE)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  domains       TenantDomain[]
  settings      TenantSetting?
  memberships   TenantMembership[]
  invitations   UserInvitation[]
  refreshTokens RefreshToken[]
  auditEvents   AuditEvent[]
  aiDocuments   AiDocument[]
}

model TenantDomain {
  id         String   @id @default(cuid())
  tenantId    String
  host       String   @unique
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model TenantSetting {
  tenantId        String       @id
  displayName     String
  logoUrl         String?
  logoUrlLight    String?
  primaryColor    String?
  supportEmail    String
  defaultLocale   LocaleCode   @default(es)
  enabledLocales  LocaleCode[] @default([es])
  timezone        String
  currency        String
  // Automation policies
  autoUpdateCountersFromDailyReport     Boolean  @default(false)
  autoCreateFindingDrafts               Boolean  @default(false)
  autoCreateWoDrafts                    Boolean  @default(false)
  requireApprovalForCriticalCorrectives Boolean  @default(true)
  requireApprovalForComplianceTasks     Boolean  @default(true)
  autoConsumeNonCriticalSpares          Boolean  @default(false)
  // PDF templates per entity (extensible: defectPdfTemplate, deferralPdfTemplate, etc.)
  workOrderPdfTemplate WorkOrderPdfTemplate @default(STANDARD)
  // Document revisions (printed in PDF headers — incrementable per tenant when forms change)
  spareInventoryRevision    Int @default(2)
  spareConsumptionRevision  Int @default(1)
  // Satellite link cost (USD per MB) — used to estimate communication cost per user/vessel
  satelliteUsdPerMbIn       Float @default(0)
  satelliteUsdPerMbOut      Float @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model PlatformUser {
  id            String            @id @default(cuid())
  email         String            @unique
  passwordHash  String
  role          PlatformRole
  status        UserStatus        @default(ACTIVE)
  firstName     String?
  lastName      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  sessions      PlatformSession[]
  auditEvents   AuditEvent[]      @relation("AuditPlatformUser")
}

model PlatformSession {
  id               String       @id @default(cuid())
  platformUserId   String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime     @default(now())

  platformUser     PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId])
  @@index([expiresAt])
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  legacyUserId     String?            @unique
  passwordHash     String
  status           UserStatus         @default(INVITED)
  preferredLocale  LocaleCode?
  firstName        String?
  lastName         String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  memberships                  TenantMembership[]
  invitations                  UserInvitation[]   @relation("InvitationAcceptedBy")
  refreshTokens                RefreshToken[]
  auditEvents                  AuditEvent[]       @relation("AuditTenantUser")
  superintendentAssignments    VesselSuperintendentAssignment[]
}

model TenantMembership {
  id                   String           @id @default(cuid())
  tenantId              String
  userId                String
  role                  TenantRole
  status                MembershipStatus @default(INVITED)
  assignedVesselCodes   String[]         @default([])
  joinedAt              DateTime?
  invitedAt             DateTime         @default(now())
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Un user puede pertenecer a varios tenants, pero sólo una vez a cada uno.
  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([role])
}

model UserInvitation {
  id                 String      @id @default(cuid())
  tenantId           String
  email              String
  role               TenantRole
  locale             LocaleCode?
  tokenHash          String      @unique
  expiresAt          DateTime
  acceptedAt         DateTime?
  acceptedByUserId   String?
  createdAt          DateTime    @default(now())

  tenant             Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  acceptedByUser     User?       @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([email])
}

model RefreshToken {
  id               String    @id @default(cuid())
  userId           String
  tenantId         String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([expiresAt])
}

model VesselSuperintendentAssignment {
  id                    String                      @id @default(cuid())
  tenantId              String
  vesselCode            String
  userId                String
  assignmentType        SuperintendentAssignmentType @default(PRIMARY)
  isActive              Boolean                     @default(true)
  assignedAt            DateTime                    @default(now())
  assignedByUserId      String
  deactivatedAt         DateTime?
  deactivatedByUserId   String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  user                  User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, vesselCode, userId])
  @@index([tenantId])
  @@index([tenantId, vesselCode])
  @@index([userId])
}

model AuditEvent {
  id                   String          @id @default(cuid())
  tenantId             String?
  actorType            AuditActorType
  actorUserId          String?
  actorPlatformUserId  String?
  action               String
  entityType           String
  entityId             String?
  metadata             Json?
  createdAt            DateTime        @default(now())

  tenant               Tenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actorUser            User?           @relation("AuditTenantUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorPlatformUser    PlatformUser?   @relation("AuditPlatformUser", fields: [actorPlatformUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Usage Event (append-only) ────────────────────────────────────────────────
// Unified log: AI token consumption + HTTP bytes traffic (satellite link cost).
// Distinguished by `kind`. SUPERADMIN-visible. Retention: 6 months (purged by cron).
model UsageEvent {
  id                    String    @id @default(cuid())
  tenantId              String
  tenantSlug            String                          // denormalized for fast filter + readable export
  userId                String
  userEmail             String                          // denormalized: survives user delete
  vesselCode            String?                         // when the request carries vessel context
  kind                  String                          // "ai_call" | "http_request"
  // ── AI-only fields ──
  feature               String?                         // "copiloto" | "fluid_analyses"
  model                 String?                         // "claude-haiku-4-5-20251001"
  inputTokens           Int       @default(0)
  outputTokens          Int       @default(0)
  cacheReadTokens       Int       @default(0)
  cacheCreationTokens   Int       @default(0)
  // ── HTTP-only fields ──
  route                 String?                         // "/app/copiloto/stream"
  method                String?                         // "GET" | "POST" | etc
  statusCode            Int?
  // ── Common ──
  bytesIn               Int       @default(0)           // request body bytes
  bytesOut              Int       @default(0)           // response body bytes
  latencyMs             Int?
  errored               Boolean   @default(false)
  ipAddress             String?                         // client IP (X-Forwarded-For first hop, validated)
  latitude              Float?                          // browser geolocation — vessel position when TECHNICIAN_OPERATOR
  longitude             Float?
  userRole              String?                         // TenantRole at time of request (denormalized)
  createdAt             DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([kind, createdAt])
  @@index([vesselCode, createdAt])
  @@index([createdAt])
}

// ─── Domain Event (append-only) ───────────────────────────────────────────────

model DomainEvent {
  id          String          @id @default(cuid())
  tenantId    String
  vesselCode  String?
  entityType  String
  entityId    String
  eventKind   DomainEventKind
  actorUserId String?
  payload     Json
  createdAt   DateTime        @default(now())

  @@index([tenantId])
  @@index([tenantId, vesselCode])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Block 05: Core Functional Modules ───────────────────────────────────────

model Vessel {
  id               String        @id @default(cuid())
  tenantId         String
  code             String
  name             String
  owner            String?
  vesselType       String?
  imo              String?
  registration     String?
  powerHp          Float?
  dwtTons          Float?
  lengthM          Float?
  beamM            Float?
  depthM           Float?
  trnTn            Float?
  trbTn            Float?
  buildYear        Int?
  buildCountry     String?
  incorporationDate DateTime?
  incorporationType String?
  status                VesselStatus  @default(ACTIVE)
  crewPasswordHash      String?
  crewPasswordUpdatedAt DateTime?
  createdAt             DateTime      @default(now())
  createdByUserId  String
  updatedAt        DateTime      @updatedAt
  updatedByUserId  String
  deletedAt        DateTime?
  deletedByUserId  String?

  assets           Asset[]
  maintenancePlans MaintenancePlan[]
  workOrders       WorkOrder[]
  defects          Defect[]
  deferrals        Deferral[]
  capaRecords      CapaRecord[]
  inspections      Inspection[]
  inspectionLogs   InspectionLog[]
  certificates     Certificate[]
  dailyReports     DailyReport[]
  providers        Provider[]
  spares           Spare[]
  stockMovements   StockMovement[]
  providerEvals    ProviderEvaluation[]
  providerNcs      ProviderNonconformity[]
  attachments      Attachment[]
  crew             Crew[]
  drills           Drill[]
  permits          PermitToWork[]
  externalAudits   ExternalAudit[]
  nearMissReports  NearMissReport[]
  checklistExecutions ChecklistExecution[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, status])
}

model Asset {
  id               String           @id @default(cuid())
  tenantId         String
  vesselCode       String
  assetCode        String
  sfiCode          String?
  name             String
  criticality      AssetCriticality @default(B)
  status           AssetStatus      @default(OPERATIONAL)
  manufacturer     String?
  model            String?
  serialNumber     String?
  installationDate DateTime?
  lastOverhaulDate DateTime?
  replacementDate  DateTime?
  trackDailyReport Boolean          @default(false)
  // Justificación textual de la criticidad asignada (manual o sugerida por IA)
  criticalityRationale String?
  // ISM Code 10.3: equipos cuya falla súbita puede causar situaciones peligrosas
  // (sistemas de gobierno, contraincendio, propulsión emergencia, etc.).
  // Independiente de criticality (A/B/C), que es operacional.
  isSafetyCritical     Boolean       @default(false)
  // PMS extensions
  equipmentClassId String?
  parentAssetId    String?
  createdAt        DateTime         @default(now())
  createdByUserId  String
  updatedAt        DateTime         @updatedAt
  updatedByUserId  String
  deletedAt        DateTime?
  deletedByUserId  String?

  vessel           Vessel           @relation(fields: [tenantId, vesselCode], references: [tenantId, code])
  equipmentClass   EquipmentClass?  @relation(fields: [equipmentClassId], references: [id], onDelete: SetNull)
