  updatedAt         DateTime         @updatedAt
  updatedByUserId   String
  deletedAt         DateTime?
  deletedByUserId   String?

  vessel            Vessel           @relation(fields: [tenantId, vesselCode], references: [tenantId, code])

  @@index([tenantId])
  @@index([tenantId, vesselCode])
  @@index([targetType, targetId])
  @@index([tenantId, uploadedAt])
}

// ─── Block 09: AI Documents & Prompt Governance ───────────────────────────────

enum PromptCapability {
  knowledge_assistant
  defect_assistant
  deferral_analysis
  barrier_interviewer
  maintenance_insights
  daily_executive_summary
  document_summarizer
  evidence_link_assistant
}

enum PromptStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model PromptTemplate {
  id          String           @id @default(cuid())
  capability  PromptCapability
  locale      String
  version     Int
  status      PromptStatus     @default(DRAFT)
  title       String
  content     String           @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  publishedAt DateTime?
  createdById String?

  @@unique([capability, locale, version])
  @@index([capability, locale, status])
}

enum AiDocumentStatus {
  ACTIVE
  ARCHIVED
}

enum AiDocumentVersionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model AiDocument {
  id              String           @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  status          AiDocumentStatus @default(ACTIVE)
  createdAt       DateTime         @default(now())
  createdByUserId String
  updatedAt       DateTime         @updatedAt
  updatedByUserId String
  deletedAt       DateTime?
  deletedByUserId String?

  versions        AiDocumentVersion[]
  tenant          Tenant             @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
}

model AiDocumentVersion {
  id                String                  @id @default(cuid())
  documentId        String
  tenantId          String
  version           Int
  status            AiDocumentVersionStatus @default(DRAFT)
  content           String                  @db.Text
  mimeType          String                  @default("text/plain")
  sizeBytes         Int                     @default(0)
  activatedAt       DateTime?
  activatedByUserId String?
  archivedAt        DateTime?
  archivedByUserId  String?
  createdAt         DateTime                @default(now())
  createdByUserId   String

  document          AiDocument              @relation(fields: [documentId], references: [id])

  @@unique([documentId, version])
  @@index([tenantId, status])
}

// ─── Block 10: AI Insights ────────────────────────────────────────────────────

enum InsightType {
  backlog_risk
  repeated_failure
  repeated_deferral
  pm_frequency_review
  stock_below_minimum
  stock_below_reorder_point
  certificate_expiring
  certificate_expired
  inspection_failure_pattern
  overdue_capa
  overdue_work_order
  documentation_gap
  operational_anomaly
  recurring_asset_downtime
  trend_based_maintenance_improvement
  cross_vessel_spare_availability
  fleet_repeated_failure_pattern
  fleet_known_fix_suggestion
  fleet_shared_operational_experience
}

enum InsightStatus {
  OPEN
  DISMISSED
  RESOLVED
}

enum InsightPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InsightTargetType {
  VESSEL
  ASSET
  WORK_ORDER
  DEFECT
  CAPA
  SPARE
  CERTIFICATE
  INSPECTION
  FLEET
}

model AiInsight {
  id             String            @id @default(cuid())
  tenantId       String
  insightCode    String
  insightType    InsightType
  status         InsightStatus     @default(OPEN)
  priority       InsightPriority   @default(MEDIUM)
  targetType     InsightTargetType
  targetId       String?
  vesselCode     String?
  title          String
  summary        String
  recommendation String
  detectedAt     DateTime          @default(now())
  resolvedAt     DateTime?
  dismissedAt    DateTime?
  createdAt      DateTime          @default(now())
  createdByUserId String
  updatedAt      DateTime          @updatedAt
  updatedByUserId String

  @@unique([tenantId, insightType, targetType, targetId])
  @@index([tenantId, status])
  @@index([tenantId, vesselCode, status])
}

// ─── Block 11: PMS — Catálogos globales ──────────────────────────────────────

model SfiNode {
  id          String   @id @default(cuid())
  code        String   // "610", "710", etc.
  description String
  groupNumber Int      // 0-9
  groupName   String
  isGlobal    Boolean  @default(true)
  tenantId    String?  // null = global; set = extensión de tenant
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([groupNumber])
}

model EquipmentClass {
  id                 String            @id @default(cuid())
  tenantId           String?           // null = global
  code               String
  name               String
  description        String?
  defaultSfiCode     String?
  defaultCriticality AssetCriticality?
  isGlobal           Boolean           @default(true)
  status             String            @default("ACTIVE")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  assets              Asset[]
  taskTemplates       ClassTaskTemplate[]
  spareLinks          SpareLink[]
  inspectionTemplates InspectionTemplate[]

  @@index([tenantId])
}

model TaskMaster {
  id                  String                 @id @default(cuid())
  tenantId            String?                // null = global
  code                String
  title               String
  taskType            TaskType
  triggerType         MaintenancePlanTrigger
  triggerResultMode   TriggerResultMode      @default(DUE_ONLY)
  frequencyDays       Int?
  frequencyHours      Float?
  estimatedHours      Float?
  procedure           String?                @db.Text
  procedureReference  String?
  acceptanceCriteria  String?
  evidenceRequired    Boolean                @default(false)
  isGlobal            Boolean                @default(true)
  status              String                 @default("ACTIVE")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  classTemplates      ClassTaskTemplate[]
  maintenancePlans    MaintenancePlan[]
  spareLinks          SpareLink[]

  @@index([tenantId])
  @@index([taskType])
}

model ClassTaskTemplate {
  id               String         @id @default(cuid())
  equipmentClassId String
  taskMasterId     String
  isDefault        Boolean        @default(true)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())

  equipmentClass   EquipmentClass @relation(fields: [equipmentClassId], references: [id], onDelete: Cascade)
  taskMaster       TaskMaster     @relation(fields: [taskMasterId], references: [id], onDelete: Cascade)

  @@unique([equipmentClassId, taskMasterId])
  @@index([equipmentClassId])
  @@index([taskMasterId])
}

// ─── Block 11: PMS — Inspecciones ────────────────────────────────────────────

model InspectionTemplate {
  id                String                 @id @default(cuid())
  tenantId          String?                // null = global
  code              String
  title             String
  description       String?
  equipmentClassId  String?
  sfiCode           String?
  triggerType       MaintenancePlanTrigger
  triggerResultMode TriggerResultMode      @default(DUE_ONLY)
  frequencyDays     Int?
  windowMode        ExecutionWindowMode    @default(AUTO)
  windowLeadDays    Int?
  evidenceRequired  Boolean                @default(false)
  isGlobal          Boolean                @default(true)
  status            String                 @default("ACTIVE")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  equipmentClass    EquipmentClass?        @relation(fields: [equipmentClassId], references: [id], onDelete: SetNull)
  checklistItems    InspectionChecklistItem[]
  executions        InspectionExecution[]

  @@index([tenantId])
}

model InspectionChecklistItem {
  id                     String              @id @default(cuid())
  templateId             String
  sortOrder              Int                 @default(0)
  description            String
  itemType               ChecklistItemType
  acceptanceCriteria     String?
  nominalValue           Float?
  minValue               Float?
  maxValue               Float?
  unit                   String?
  requiresInstrument     Boolean             @default(false)
  requiredInstrumentType String?
  evidenceRequired       Boolean             @default(false)
  deficiencySeverity     DeficiencySeverity?
  criteriaSource         CriteriaSource?
  isOptional             Boolean             @default(false)

  template               InspectionTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  itemResults            InspectionItemResult[]

  @@index([templateId])
}

model InspectionExecution {
  id                  String                     @id @default(cuid())
  tenantId            String
  vesselCode          String
  assetId             String?
  templateId          String
  executionCode       String
  status              InspectionStatus           @default(SCHEDULED)
  result              InspectionExecutionResult?
  scheduledAt         DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  inspectorUserId     String?
  inspectorName       String?
  generalObservations String?
  nextScheduledDate   DateTime?
  createdAt           DateTime                   @default(now())
  createdByUserId     String
  updatedAt           DateTime                   @updatedAt
  updatedByUserId     String
  deletedAt           DateTime?
  deletedByUserId     String?

  template            InspectionTemplate         @relation(fields: [templateId], references: [id])
  asset               Asset?                     @relation(fields: [assetId], references: [id], onDelete: SetNull)
  itemResults         InspectionItemResult[]

  @@unique([tenantId, vesselCode, executionCode])
  @@index([tenantId])
  @@index([tenantId, vesselCode])
  @@index([tenantId, status])
}

model InspectionItemResult {
  id                 String                  @id @default(cuid())
  executionId        String
  checklistItemId    String
  resultValue        String?
  numericValue       Float?
  isConforming       Boolean?
  deficiencySeverity DeficiencySeverity?
  instrumentId       String?
  notes              String?
  createdAt          DateTime                @default(now())

  execution          InspectionExecution     @relation(fields: [executionId], references: [id], onDelete: Cascade)
  checklistItem      InspectionChecklistItem @relation(fields: [checklistItemId], references: [id])
  instrument         Instrument?             @relation(fields: [instrumentId], references: [id], onDelete: SetNull)

  @@unique([executionId, checklistItemId])
  @@index([executionId])
}

// ─── Block 11: PMS — Instrumentos ────────────────────────────────────────────

model Instrument {
  id                  String     @id @default(cuid())
  tenantId            String
  vesselCode          String?
  code                String
  name                String
  instrumentType      String
  serialNumber        String?
  calibrationRequired Boolean    @default(false)
  calibrationDate     DateTime?
  calibrationDueDate  DateTime?
  status              String     @default("ACTIVE")
  notes               String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  itemResults         InspectionItemResult[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

// ─── Block 11: PMS — Work Logs ───────────────────────────────────────────────

model WorkLog {
  id                      String        @id @default(cuid())
  tenantId                String
  vesselCode              String
  workOrderId             String?
  maintenancePlanId       String?
  assetId                 String
  logCode                 String
  taskType                TaskType
  result                  WorkLogResult
  startedAt               DateTime
  completedAt             DateTime?
  executedByUserId        String?
  executedByName          String
  hoursWorked             Float?
  runningHoursAtExecution Float?
  notes                   String?       @db.Text
  followUpRequired        Boolean       @default(false)
  createdAt               DateTime      @default(now())
  createdByUserId         String

  workOrder               WorkOrder?      @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  maintenancePlan         MaintenancePlan? @relation(fields: [maintenancePlanId], references: [id], onDelete: SetNull)

  @@unique([tenantId, vesselCode, logCode])
  @@index([tenantId])
  @@index([tenantId, vesselCode])
  @@index([workOrderId])
  @@index([maintenancePlanId])
}

// ─── Block 11: PMS — Repuestos sugeridos ─────────────────────────────────────

model SpareLink {
  id               String          @id @default(cuid())
  tenantId         String?
  equipmentClassId String?
  taskMasterId     String?
  spareSku         String?
  spareName        String
  isConsumable     Boolean         @default(false)
  estimatedQty     Float           @default(1)
  unit             String?
  notes            String?
  createdAt        DateTime        @default(now())

  equipmentClass   EquipmentClass? @relation(fields: [equipmentClassId], references: [id], onDelete: SetNull)
  taskMaster       TaskMaster?     @relation(fields: [taskMasterId], references: [id], onDelete: SetNull)

  @@index([equipmentClassId])
  @@index([taskMasterId])
}

// ─── Block 12: Análisis de Fluidos (lubricantes, combustibles, agua) ─────────

model FluidSample {
  id                 String              @id @default(cuid())
  tenantId           String
  vesselCode         String
  assetId            String
  sampleCode         String
  fluidType          FluidType
  fluidProduct       String?
  sampledAt          DateTime
  runningHours       Float?
  sampledByUserId    String?
  containerCode      String?
  sentAt             DateTime?
  labName            String?
  labReference       String?
  status             FluidSampleStatus   @default(DRAFT)
  notes              String?
  // Trazabilidad cuando el sample fue generado automáticamente al cerrar una OT
  sourceWorkOrderId  String?
  sourcePlanId       String?
  createdAt        DateTime            @default(now())
  createdByUserId  String
  updatedAt        DateTime            @updatedAt
  updatedByUserId  String
  deletedAt        DateTime?
  deletedByUserId  String?

  result           FluidAnalysisResult?

  @@unique([tenantId, vesselCode, sampleCode])
  @@index([tenantId])
  @@index([tenantId, vesselCode])
  @@index([tenantId, assetId])
  @@index([tenantId, fluidType])
  @@index([tenantId, status])
}

model FluidAnalysisResult {
  id               String       @id @default(cuid())
  tenantId         String
  sampleId         String       @unique
  receivedAt       DateTime
  verdict          FluidVerdict @default(NORMAL)
  summary          String?
  parameters       Json
  reportUrl        String?
  reportMime       String?
  reportSourceText String?
  defectId         String?
  // AI analysis: tendencias clave, interpretación, recomendaciones (markdown)
  aiAnalysis            String?
  aiAnalysisGeneratedAt DateTime?
  enteredByUserId  String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  sample           FluidSample  @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([verdict])
}

model FluidParameterThreshold {
  id            String                  @id @default(cuid())
  tenantId      String
  fluidType     FluidType
  parameter     String
  label         String
  unit          String?
  cautionMin    Float?
  cautionMax    Float?
  criticalMin   Float?
  criticalMax   Float?
  direction     FluidThresholdDirection @default(HIGH_BAD)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([tenantId, fluidType, parameter])
  @@index([tenantId, fluidType])
}

// ── Block: Crew / Certificaciones / Drills (Vetting Sprint 1 — TMSA 4 Elem. 3) ─

model Crew {
  id                 String          @id @default(cuid())
  tenantId           String
  vesselCode         String
  crewCode           String
  firstName          String
  lastName           String
  rank               CrewRank
  nationality        String?
  dateOfBirth        DateTime?
  passportNumber     String?
  signOnDate         DateTime
  signOffDate        DateTime?
  status             CrewStatus      @default(ONBOARD)
  notes              String?
  createdAt          DateTime        @default(now())
  createdByUserId    String
  updatedAt          DateTime        @updatedAt
  updatedByUserId    String
  deletedAt          DateTime?
  deletedByUserId    String?

  // Audit trail de re-aperturas (cuando un crew SIGNED_OFF se re-abre)
  reopenCount        Int             @default(0)
  lastReopenAt       DateTime?
  lastReopenReason   String?
  lastReopenByUserId String?

  vessel             Vessel          @relation(fields: [tenantId, vesselCode], references: [tenantId, code])
  certifications     CrewCertification[]

  @@unique([tenantId, vesselCode, crewCode])
  @@index([tenantId])
  @@index([tenantId, vesselCode])
  @@index([tenantId, status])
}

model CrewCertification {
  id                 String                  @id @default(cuid())
  tenantId           String
  crewId             String
  type               CrewCertificationType
  certificateNumber  String?
  issuingAuthority   String?
  issuedDate         DateTime?
  expiryDate         DateTime?
  docUrl             String?
  status             CrewCertificationStatus @default(VALID)
  notes              String?
  createdAt          DateTime                @default(now())
  createdByUserId    String
  updatedAt          DateTime                @updatedAt
  updatedByUserId    String
  deletedAt          DateTime?
  deletedByUserId    String?

  crew               Crew                    @relation(fields: [crewId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([crewId])
  @@index([tenantId, status])
  @@index([expiryDate])
}

model Drill {
  id                 String          @id @default(cuid())
  tenantId           String
  vesselCode         String
  drillCode          String
  type               DrillType
  status             DrillStatus     @default(SCHEDULED)
  scheduledDate      DateTime
  completedDate      DateTime?
  scenario           String?
  observations       String?
  lessonsLearned     String?
  // JSON array de crewId; simplifica vs tabla DrillParticipant separada
  participantCrewIds Json            @default("[]")
  pdfUrl             String?
  createdAt          DateTime        @default(now())
  createdByUserId    String
  updatedAt          DateTime        @updatedAt
  updatedByUserId    String
  deletedAt          DateTime?
  deletedByUserId    String?

  // Audit trail de re-aperturas (cuando un drill COMPLETED/CANCELLED se re-abre)
  reopenCount        Int             @default(0)
  lastReopenAt       DateTime?
  lastReopenReason   String?
  lastReopenByUserId String?

  vessel             Vessel          @relation(fields: [tenantId, vesselCode], references: [tenantId, code])

  @@unique([tenantId, vesselCode, drillCode])
  @@index([tenantId])
  @@index([tenantId, vesselCode])
  @@index([tenantId, status])
  @@index([scheduledDate])
}

// Frecuencia mínima por tipo de simulacro, configurable por tenant.
// Si no existe registro para un tipo, el servicio aplica el default
// DRILL_FREQUENCY_DAYS (SOLAS/ISPS/MARPOL).
model DrillConfig {
  id              String    @id @default(cuid())
  tenantId        String
  type            DrillType
  frequencyDays   Int
  enabled         Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  updatedByUserId String

  @@unique([tenantId, type])
  @@index([tenantId])
}

// ── Block: Permit to Work (Vetting Sprint 1 — SOLAS II-2/10, XI-1/7, SIRE 2.0) ─

model PermitToWork {
  id                 String          @id @default(cuid())
  tenantId           String
  vesselCode         String
  permitCode         String
  type               PermitType
  status             PermitStatus    @default(DRAFT)
  // Refs opcionales: un PTW puede originarse de una OT/asset, o ser libre.
  assetId            String?
  workOrderId        String?
  location           String
  description        String
  // Ventana de validez del permiso (típicamente <= 24 h en hot work).
  plannedStart       DateTime
  plannedEnd         DateTime
  validFrom          DateTime?
  validTo            DateTime?
  // Workflow timestamps + autores.
  requestedAt        DateTime?
  requestedByUserId  String?
  approvedAt         DateTime?
  approvedByUserId   String?
  activatedAt        DateTime?
  activatedByUserId  String?
  closedAt           DateTime?
  closedByUserId     String?
  closeNotes         String?
  rejectionReason    String?
  cancelReason       String?
  // Contenido principal (texto libre, derivable de la operación).
  hazardsIdentified  String?
  controlMeasures    String?
  ppeRequired        String?
  // Campos específicos por tipo (isolationPoints / harnessType / hotWorkClass / etc.).
  details            Json            @default("{}")
  // MOC trigger: bypass/override de alarma crítica dispara TEMPORARY MOC
  alarmOverride      Boolean         @default(false)
  createdAt          DateTime        @default(now())
  createdByUserId    String
  updatedAt          DateTime        @updatedAt
  updatedByUserId    String
  deletedAt          DateTime?
  deletedByUserId    String?

  // Audit trail de re-aperturas (cuando un permiso terminal se re-abre)
  reopenCount        Int             @default(0)
  lastReopenAt       DateTime?
  lastReopenReason   String?
  lastReopenByUserId String?

  vessel             Vessel          @relation(fields: [tenantId, vesselCode], references: [tenantId, code])
  gasTests           PermitGasTest[]
  participants       PermitParticipant[]

  @@unique([tenantId, vesselCode, permitCode])
  @@index([tenantId])
  @@index([tenantId, vesselCode])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([validTo])
}

model PermitGasTest {
  id              String           @id @default(cuid())
  tenantId        String
  permitId        String
  testedAt        DateTime
  testedByName    String
  location        String?
  // Lecturas: nullable porque algunos sensores miden subset.
  o2Pct           Float?
  lelPct          Float?
  h2sPpm          Float?
  coPpm           Float?
  verdict         PermitGasVerdict
  notes           String?
  createdAt       DateTime         @default(now())
  createdByUserId String

  permit          PermitToWork     @relation(fields: [permitId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([permitId])
  @@index([tenantId, testedAt])
}

model PermitParticipant {
  id              String                @id @default(cuid())
  tenantId        String
  permitId        String
  // crewId es opcional — admite participantes externos (contratistas) por nombre libre.
  crewId          String?
  name            String
  role            PermitParticipantRole
  createdAt       DateTime              @default(now())
  createdByUserId String

  permit          PermitToWork          @relation(fields: [permitId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([permitId])
  @@index([crewId])
}

// ─── Block: External Audits (PSC / Flag / Class / Vetting) — SIRE 2.0 Ch. 4 ────
// Registro histórico de inspecciones externas, separado de las inspecciones
// internas. SIRE pregunta explícitamente por PSC findings pasados.

enum ExternalAuditType {
  PSC                 // Port State Control
  FLAG                // Flag State
  CLASS               // Sociedad de Clasificación
  VETTING_OIL_MAJOR   // SIRE inspection previo / vetting de oil major
  CDI                 // Chemical Distribution Institute
  RIGHTSHIP           // RightShip
  OTHER
}

enum ExternalAuditFindingType {
  DEFICIENCY
  OBSERVATION
  RECOMMENDATION
  POSITIVE_OBSERVATION
}

enum ExternalAuditFindingStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  REJECTED_BY_AUDITOR
}

model ExternalAudit {
  id                 String              @id @default(cuid())
  tenantId           String
  vesselCode         String
  auditCode          String              // EXT-VESSEL-YY-####
  auditType          ExternalAuditType
  auditDate          DateTime
  port               String?
  country            String?
  agencyOrAuthority  String?             // "USCG", "MCA", "Shell", "BP", "ABS", etc.
  inspectorName      String?
  durationHours      Decimal?            @db.Decimal(5, 2)
  overallResult      String?             // "Pass", "Conditional", "Fail", "Acceptable"
  summary            String?             // resumen general
  scoreOrRating      String?             // "85%", "B-", etc.
  reportUrl          String?             // URL al PDF original del informe
  createdAt          DateTime            @default(now())
  createdByUserId    String
  updatedAt          DateTime            @updatedAt
  updatedByUserId    String
  deletedAt          DateTime?
  deletedByUserId    String?

  vessel             Vessel              @relation(fields: [tenantId, vesselCode], references: [tenantId, code])
  findings           ExternalAuditFinding[]

  @@unique([tenantId, vesselCode, auditCode])
  @@index([tenantId])
  @@index([tenantId, vesselCode])
  @@index([tenantId, auditType])
  @@index([auditDate])
}

model ExternalAuditFinding {
  id                String                     @id @default(cuid())
  tenantId          String
  auditId           String
  vesselCode        String
  // findingCode: código del inspector (ej. PSC code "30150", SIRE Q "7.1.2").
  findingCode       String?
  findingType       ExternalAuditFindingType
  category          String?                    // "Safety", "Pollution prevention", "Crew", "Cargo"
  description       String                     // qué se encontró
  status            ExternalAuditFindingStatus @default(OPEN)
  // Severidad solo aplica a DEFICIENCY. "MINOR" / "MAJOR" / "CRITICAL".
  severity          String?
  detentionRelated  Boolean                    @default(false)
  rectificationDeadline DateTime?
  clearingDate      DateTime?
  evidenceNotes     String?                    // qué evidencia se aportó al cerrar
  evidenceDocUrl    String?
  createdAt         DateTime                   @default(now())
  createdByUserId   String
  updatedAt         DateTime                   @updatedAt
  updatedByUserId   String

  audit             ExternalAudit              @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([auditId])
  @@index([tenantId, vesselCode, status])
}

// ─── Block: Near Miss / Hazard Observation — SIRE 2.0 Ch. 4 Safety ─────────────
// Separado de Defect: el defecto es un problema material (algo está roto o
// degradado); el near miss es un evento o condición que pudo haber causado
// daño pero no lo causó. Cultura de reporte es clave en SIRE.

enum NearMissCategory {
  NEAR_MISS            // Evento que pudo causar daño pero no lo causó
  HAZARD_OBSERVATION   // Condición de riesgo observada (sin evento)
  UNSAFE_ACT           // Acción humana insegura observada
  UNSAFE_CONDITION     // Estado físico inseguro
}

enum NearMissSeverity {
  LOW                  // Potencial de daño bajo
  MEDIUM               // Potencial de lesión leve
  HIGH                 // Potencial de lesión grave / daño mayor
  CRITICAL             // Potencial de fatalidad / pérdida total
}

enum NearMissStatus {
  REPORTED
  UNDER_REVIEW
  ACTIONED             // Acción correctiva aplicada
  CLOSED
}

model NearMissReport {
  id                String           @id @default(cuid())
  tenantId          String
  vesselCode        String
  nearMissCode      String           // NM-VESSEL-YY-####
  category          NearMissCategory
  severity          NearMissSeverity @default(MEDIUM)
  status            NearMissStatus   @default(REPORTED)
  occurredAt        DateTime
  location          String?          // "Sala de máquinas", "Cubierta", "Puente"
  description       String
  immediateAction   String?
  rootCause         String?
  preventiveActions String?
  lessonsLearned    String?
  assetId           String?
  reportedByName    String?          // crew code o nombre libre
  reportedByCrewId  String?
  reviewedAt        DateTime?
  reviewedByUserId  String?
  closedAt          DateTime?
  createdAt         DateTime         @default(now())
  createdByUserId   String
  updatedAt         DateTime         @updatedAt
  updatedByUserId   String
  deletedAt         DateTime?
  deletedByUserId   String?

  vessel            Vessel           @relation(fields: [tenantId, vesselCode], references: [tenantId, code])

  @@unique([tenantId, vesselCode, nearMissCode])
  @@index([tenantId])
  @@index([tenantId, vesselCode])
  @@index([tenantId, status])
  @@index([occurredAt])
}

// ─── Block: Hours of Rest — STCW Manila / MLC 2006 ─────────────────────────────
// Una fila por (crew, día). El registro de horas se modela como un array de
// 24 booleans en JSON: true = descanso, false = trabajo, indexado por hora
// del día (0..23 en hora local del buque). El cálculo de violaciones
// (mínimo 10h/24h, 77h/7d, no más de 2 períodos en 24h con uno ≥6h) se hace
// en el servicio al consultar.

model CrewRestHours {
  id              String   @id @default(cuid())
  tenantId        String
  vesselCode      String
  crewId          String
  recordDate      DateTime @db.Date
  // hoursData: Json[24]; true = descanso. Si no hay datos, se asume work=true.
  hoursData       Json     @default("[false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false]")
  notes           String?
  // Snapshot calculado al guardar — útil para listados y reportes sin recomputar.
  totalRestHours  Decimal? @db.Decimal(4, 2)
  hasViolation    Boolean  @default(false)
  violationsJson  Json?    // { kind: "...", details: "..." }[]
  createdAt       DateTime @default(now())
  createdByUserId String
  updatedAt       DateTime @updatedAt
  updatedByUserId String

  @@unique([tenantId, vesselCode, crewId, recordDate])
  @@index([tenantId])
  @@index([tenantId, vesselCode, recordDate])
  @@index([crewId, recordDate])
  @@index([tenantId, hasViolation])
}

// ─── Block: Pre-Arrival / Pre-Departure / Pre-Bunkering Checklists ─────────────
// SIRE 2.0 Ch. 4 + ISGOTT + ISM. Listas de verificación firmadas que el
// inspector pide ver. Templates con items + ejecución por evento.

enum ChecklistTemplateType {
  PRE_ARRIVAL
  PRE_DEPARTURE
  PRE_BUNKERING
  PRE_CARGO_TRANSFER
  ENCLOSED_SPACE_ENTRY
  HOT_WORK
  PILOT_BOARDING
  ANCHOR
  MOORING
  OTHER
}

enum ChecklistExecutionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ChecklistItemResponseStatus {
  PENDING
  CONFORMING
  NOT_CONFORMING
  NOT_APPLICABLE
}

model ChecklistTemplate {
  id              String                @id @default(cuid())
  tenantId        String?               // null = template global (compartido)
  type            ChecklistTemplateType
  name            String
  description     String?
  // items: array de { code, text, isMandatory, category? } guardado JSON
  // para evitar una tabla más con tan pocos campos.
  itemsJson       Json                  @default("[]")
  isActive        Boolean               @default(true)
  // MOC trigger: edición de plantilla aprobada dispara PROCEDURE_CHANGE
  approvedAt      DateTime?
  approvedByUserId String?
  createdAt       DateTime              @default(now())
  createdByUserId String
  updatedAt       DateTime              @updatedAt
  updatedByUserId String

  executions      ChecklistExecution[]

  @@index([tenantId])
  @@index([type])
}

model ChecklistExecution {
  id                String                       @id @default(cuid())
  tenantId          String
  vesselCode        String
  templateId        String
  executionCode     String                       // CHK-VESSEL-YY-####
  type              ChecklistTemplateType
  status            ChecklistExecutionStatus     @default(IN_PROGRESS)
  // Contexto del evento
  eventDateTime     DateTime
  port              String?
  voyageRef         String?
  performedByName   String?                      // nombre del que llenó
  performedByCrewId String?
  signedByName      String?                      // capitán o responsable
  signedByCrewId    String?
  signedAt          DateTime?
  notes             String?
  // Snapshot calculado al cerrar
  totalItems        Int                          @default(0)
  conformingItems   Int                          @default(0)
  notConformingItems Int                         @default(0)
  createdAt         DateTime                     @default(now())
  createdByUserId   String
  updatedAt         DateTime                     @updatedAt
  updatedByUserId   String
  deletedAt         DateTime?
  deletedByUserId   String?

  template          ChecklistTemplate            @relation(fields: [templateId], references: [id])
  vessel            Vessel                       @relation(fields: [tenantId, vesselCode], references: [tenantId, code])
  responses         ChecklistItemResponse[]

  @@unique([tenantId, vesselCode, executionCode])
  @@index([tenantId])
  @@index([tenantId, vesselCode])
  @@index([tenantId, type, status])
  @@index([eventDateTime])
}

model ChecklistItemResponse {
  id              String                       @id @default(cuid())
  tenantId        String
  executionId     String
  // itemCode = mismo code del itemsJson del template; permite mantener
  // la asociación aunque el template se edite a futuro.
  itemCode        String
  itemText        String                       // copia del texto al momento del llenado
  status          ChecklistItemResponseStatus  @default(PENDING)
  notes           String?
  reportedByName  String?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  updatedByUserId String

  execution       ChecklistExecution           @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, itemCode])
  @@index([tenantId])
  @@index([executionId])
}

// ─── Block: Crew Capability Matrix ────────────────────────────────────────────
// Quién está calificado para qué tarea crítica. Útil para asignar OTs / PTW /
// drills y para responder preguntas SIRE como "¿quién puede operar X?".

enum CapabilityLevel {
  TRAINED              // Hizo el curso pero no está certificado
  CERTIFIED            // Tiene la certificación vigente
  EXPERT               // Instructor / referente
}

enum CapabilityArea {
  ECDIS                // Operación ECDIS
  BWMS                 // Ballast Water Management System
  IG_SYSTEM            // Inert Gas system
  CARGO_HANDLING       // Operación de carga
  MOORING_MASTER       // Mooring master / amarre supervisado
  ENCLOSED_SPACE_ENTRY // Entry team / rescatista
  HOT_WORK             // Hot work permit holder
  RADAR_ARPA           // Radar / ARPA
  GMDSS                // GMDSS operator
  BRIDGE_RESOURCE_MGMT // BRM
  ENGINE_ROOM_RESOURCE // ERM
  FIRE_FIGHTING        // Advanced fire fighting (más allá de BST)
  SURVIVAL_CRAFT       // Bote / balsa
  MEDICAL_FIRST_AID    // Primeros auxilios
  HIGH_VOLTAGE         // Trabajo con alta tensión
  CRANE_OPERATION      // Operación de grúa / pluma
  OTHER
}

model CrewCapability {
  id              String           @id @default(cuid())
  tenantId        String
  crewId          String
  area            CapabilityArea
  level           CapabilityLevel  @default(CERTIFIED)
  // Vinculación opcional con certificación existente como evidencia.
  certificationId String?
  notes           String?
  validUntil      DateTime?
  createdAt       DateTime         @default(now())
  createdByUserId String
  updatedAt       DateTime         @updatedAt
  updatedByUserId String

  @@unique([crewId, area])
  @@index([tenantId])
  @@index([crewId])
  @@index([tenantId, area])
}

// ─── Block: Management of Change (MOC) — SIRE 2.0 Ch. 4 + ISM ──────────────────
// Workflow formal de cambios significativos al buque / sistemas / procedimientos.

enum MocCategory {
  EQUIPMENT_CHANGE     // Cambio físico de equipo (instalación, modificación)
  PROCEDURE_CHANGE     // Cambio en procedimiento operativo
  ORGANIZATIONAL       // Cambio organizacional / responsabilidades
  TEMPORARY            // Cambio temporal (bypass, workaround)
  SOFTWARE_FIRMWARE    // Cambio de software/firmware
  OTHER
}

enum MocRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MocStatus {
  REQUESTED            // Solicitado, pendiente de análisis
  UNDER_ANALYSIS       // En análisis de impacto/riesgo
  APPROVED             // Aprobado, pendiente de implementación
  IN_PROGRESS          // Implementación en curso
  IMPLEMENTED          // Implementado, pendiente de revisión post
  REVIEWED             // Revisado post-implementación, cerrado satisfactorio
  REJECTED
  CANCELLED
}

model MocRecord {
  id                    String        @id @default(cuid())
  tenantId              String
  vesselCode            String
  mocCode               String        // MOC-VESSEL-YY-####
  category              MocCategory
  status                MocStatus     @default(REQUESTED)
  title                 String
  reasonForChange       String
  proposedChange        String
  riskLevel             MocRiskLevel  @default(MEDIUM)
  // Análisis de impacto: array JSON con áreas afectadas (Safety, Environment, etc.).
  impactAreasJson       Json          @default("[]")
  riskAssessmentNotes   String?
  mitigationActions     String?
  // Aprobación
  approvedAt            DateTime?
  approvedByUserId      String?
  approvedByName        String?
  rejectedReason        String?
  // Implementación
  plannedDate           DateTime?
  implementedAt         DateTime?
  implementedByName     String?
  implementationNotes   String?
  // Revisión post
  reviewedAt            DateTime?
  reviewedByUserId      String?
  reviewNotes           String?
  reviewOutcome         String?        // "SATISFACTORY" / "WITH_OBSERVATIONS" / "REOPEN"
  // Vínculos opcionales
  relatedAssetId        String?
  relatedWorkOrderId    String?
  createdAt             DateTime      @default(now())
  createdByUserId       String
  updatedAt             DateTime      @updatedAt
  updatedByUserId       String
  deletedAt             DateTime?
  deletedByUserId       String?

  @@unique([tenantId, vesselCode, mocCode])
  @@index([tenantId])
  @@index([tenantId, vesselCode])
  @@index([tenantId, status])
}

