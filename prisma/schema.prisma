model MaintenancePlan {
  id                   String                 @id @default(cuid())
  tenantId             String
  vesselCode           String
  assetId              String
  taskCode             String
  title                String
  description          String?
  triggerType          MaintenancePlanTrigger
  frequencyHours       Float?
  frequencyMonths      Int?
  estimatedHours       Float?
  responsible          String?
  acceptanceCriteria   String?
  loto                 String?
  sfiGroupNumber       Int?
  sfiSubgroupCode      String?
  riskLevel            String?
  riskAnalysisResult   String?
  taskType             TaskType               @default(MAINTENANCE)
  // RCM: clasificación de qué consecuencia mitiga este plan. Usado para
  // reportes de distribución por consecuencia y para ordenar prioridades.
  consequenceCategory  ConsequenceCategory?
  // Justificación textual de la categoría de consecuencia (manual o IA)
  consequenceRationale String?
  status               MaintenancePlanStatus  @default(ACTIVE)
  lastExecutionDate    DateTime?
  nextDueDate          DateTime?
  lastExecutionHours   Float?
  nextDueHours         Float?
  // PMS extensions
  taskMasterId         String?
  // Fluid sampling: si está set, al cerrar la OT generada por este plan se
  // crea automáticamente un FluidSample DRAFT con horas y datos del activo.
  samplingFluidType    FluidType?
  triggerResultMode    TriggerResultMode      @default(DUE_ONLY)
  checklistTemplate    String?
  windowMode           ExecutionWindowMode    @default(AUTO)
  windowLeadDays       Int?
  windowLeadHours      Float?
  windowLeadPercent    Float?
  windowOpenDate       DateTime?
  windowOpenHours      Float?
  executionStatus      ExecutionStatus        @default(FUTURE)
  createdAt            DateTime               @default(now())
  createdByUserId      String
  updatedAt            DateTime               @updatedAt
  updatedByUserId      String
  deletedAt            DateTime?
  deletedByUserId      String?

  vessel               Vessel                 @relation(fields: [tenantId, vesselCode], references: [tenantId, code])
  taskMaster           TaskMaster?            @relation(fields: [taskMasterId], references: [id], onDelete: SetNull)
  workLogs             WorkLog[]

  @@unique([tenantId, vesselCode, taskCode])
  @@index([tenantId])
  @@index([tenantId, vesselCode])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt, nextDueDate])
}

model WorkOrder {
  id                  String            @id @default(cuid())
  tenantId            String
  vesselCode          String
  assetId             String
  maintenancePlanId   String?
  workOrderCode       String
  type                WorkOrderType
  status              WorkOrderStatus   @default(PLANNED)
  priority            WorkOrderPriority @default(MEDIUM)
  criticality         AssetCriticality  @default(B)
  openDate            DateTime
  startDate           DateTime?
  dueDate             DateTime?
  completedDate       DateTime?
  holdReason          String?
  cancelReason        String?
  closeNotes          String?
  independentVerifier String?
  testResult          String?
  // PMS extensions
  title               String?
  description         String?
  assignedToUserId    String?
  estimatedHours      Float?
  actualHours         Float?
  taskMasterId        String?
  // Plan fields
  acceptanceCriteria  String?
  loto                String?
  riskLevel           String?
  riskAnalysisResult  String?
  checklistDocUrl     String?
  // RCM: consecuencia que se mitiga si la OT no se ejecuta
  consequenceCategory  ConsequenceCategory?
  consequenceRationale String?
  // Mercurio form fields
  department              WorkOrderDepartment?
  location                String?
  communicationMethod     String[]
  distribution            String[]
  // Result fields
  woResult                String?
  executedByName          String?
  observations            String?
  supportingDocUrl        String?
  runningHoursAtExecution Float?
  createdAt           DateTime          @default(now())
  createdByUserId     String
  updatedAt           DateTime          @updatedAt
  updatedByUserId     String
  deletedAt           DateTime?
  deletedByUserId     String?
  // Audit trail de re-aperturas. Una OT CLOSED/CANCELLED solo puede modificarse
  // tras un reopen explícito por TENANT_ADMIN con justificación obligatoria.
  reopenCount         Int               @default(0)
  lastReopenAt        DateTime?
  lastReopenReason    String?
  lastReopenByUserId  String?

  vessel              Vessel            @relation(fields: [tenantId, vesselCode], references: [tenantId, code])
  workLogs            WorkLog[]
  progressNotes       WorkOrderProgressNote[]

  @@unique([tenantId, vesselCode, workOrderCode])
  @@index([tenantId])
  @@index([tenantId, vesselCode])
  @@index([tenantId, status])
  @@index([tenantId, openDate])
}

enum WorkOrderProgressKind {
  TEXT
  PHOTO
  VIDEO
  AUDIO
}

// Notas de avance que el técnico carga durante la ejecución de una OT.
// Cada nota puede ser texto, foto, video o audio. La AI (en una iteración
// posterior) las procesa: transcribe audio, hace OCR de fotos, y reescribe
// el texto consolidado en formato técnico hacia WorkOrder.observations.
model WorkOrderProgressNote {
  id              String                @id @default(cuid())
  tenantId        String
  vesselCode      String
  workOrderId     String
  kind            WorkOrderProgressKind
  // Texto crudo: lo que el usuario tipeó (TEXT) o caption (PHOTO/VIDEO/AUDIO)
  text            String?               @db.Text
  // Archivo asociado (solo PHOTO/VIDEO/AUDIO)
  fileUrl         String?
  mimeType        String?
  sizeBytes       Int?
  // Resultado del pipeline AI: texto efectivo a sumar al "texto1"
  // (transcripción de audio, OCR de foto, o text crudo si es TEXT).
  processedText   String?               @db.Text
  processed       Boolean               @default(false)
  // Error si el pipeline AI falla, para no quedar trabados
  processError    String?               @db.Text
  createdAt       DateTime              @default(now())
  createdByUserId String
  deletedAt       DateTime?
  deletedByUserId String?

  workOrder       WorkOrder             @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workOrderId])
  @@index([tenantId, vesselCode])
}

