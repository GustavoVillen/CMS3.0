  @@index([tenantId])
  @@index([spareId])
  @@index([requestItemId])
  @@index([tenantId, status])
}

model ProviderEvaluation {
  id               String           @id @default(cuid())
  tenantId         String
  vesselCode       String
  providerId       String
  evaluationCode   String
  status           EvaluationStatus @default(DRAFT)
  score            Float
  rating           EvaluationRating
  evaluatedAt      DateTime
  evaluatorName    String
  summary          String?
  notes            String?
  createdAt        DateTime         @default(now())
  createdByUserId  String
  updatedAt        DateTime         @updatedAt
  updatedByUserId  String
  deletedAt        DateTime?
  deletedByUserId  String?

  vessel           Vessel           @relation(fields: [tenantId, vesselCode], references: [tenantId, code])
  provider         Provider         @relation(fields: [providerId], references: [id])

  @@unique([tenantId, vesselCode, evaluationCode])
  @@index([tenantId])
  @@index([tenantId, vesselCode])
  @@index([providerId])
}

model ProviderNonconformity {
  id                String     @id @default(cuid())
  tenantId          String
  vesselCode        String
  providerId        String
  nonconformityCode String
  status            NcStatus   @default(OPEN)
  severity          NcSeverity @default(MEDIUM)
  reportedAt        DateTime
  description       String
  correctiveAction  String?
  closedAt          DateTime?
  createdAt         DateTime   @default(now())
  createdByUserId   String
  updatedAt         DateTime   @updatedAt
  updatedByUserId   String
  deletedAt         DateTime?
  deletedByUserId   String?

  vessel            Vessel     @relation(fields: [tenantId, vesselCode], references: [tenantId, code])
  provider          Provider   @relation(fields: [providerId], references: [id])

  @@unique([tenantId, vesselCode, nonconformityCode])
  @@index([tenantId])
  @@index([tenantId, vesselCode])
  @@index([providerId])
}

// ─── Attachments ──────────────────────────────────────────────────────────────

model Attachment {
  id                String           @id @default(cuid())
  tenantId          String
  vesselCode        String
  targetType        AttachmentTarget
  targetId          String
  filename          String
  mimeType          String
  sizeBytes         Int
  status            AttachmentStatus @default(ACTIVE)
  uploadedAt        DateTime
