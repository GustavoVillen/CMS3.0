DATABASE_URL=postgresql://user:password@127.0.0.1:5433/pms_saas
NODE_ENV=development
PORT=3105
APP_ROOT_DOMAIN=localhost
APP_ADMIN_SUBDOMAIN=admin
APP_ALLOW_TENANT_HEADER_FALLBACK=true
ANTHROPIC_API_KEY=sk-ant-...

# Mail provider (used by the weekly Excel backup feature).
# Without these set, mail is fail-closed: weekly backup endpoints respond
# MAIL_NOT_CONFIGURED and the scheduler skips runs.
MAIL_PROVIDER=resend
MAIL_API_KEY=re_...
MAIL_FROM=GPMS <noreply@yourdomain.com>
