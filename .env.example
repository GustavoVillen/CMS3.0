DATABASE_URL=postgresql://user:password@127.0.0.1:5433/cms3
NODE_ENV=development
PORT=3106
APP_ROOT_DOMAIN=localhost
APP_ADMIN_SUBDOMAIN=admin
APP_ALLOW_TENANT_HEADER_FALLBACK=true
# Proveedor de IA para TODO el sistema (copiloto, defectos, MOC, TMSA, fluidos,
# órdenes de trabajo, permisos, simulacros, planes): "anthropic" | "gemini".
# Cambiar esta variable mueve el sistema entero de un proveedor al otro.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=
# Overrides opcionales de modelo cuando AI_PROVIDER=gemini (para probar otro
# modelo sin tocar código). Defaults: flash-lite para todo, flash para el
# informe de análisis de fluidos.
GEMINI_MODEL_FAST=
GEMINI_MODEL_DEEP=
# Voz del copiloto (TTS). Sin ELEVENLABS_API_KEY, el botón "Escuchar" cae
# automáticamente a la voz del navegador (gratis). ELEVENLABS_VOICE_ID es
# opcional; por default usa la voz "Melody" (bN1bDXgDIGX5lw0rtY2B).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Poner en 1 SOLO en producción detrás de un proxy de confianza (nginx) que
# reescribe X-Forwarded-For / X-Real-IP. Habilita el rate-limit por IP real del
# cliente. Sin esto (o en local), esos headers se ignoran para no ser spoofeables.
# OJO: la consola de Accesos del SUPERADMIN depende de esto. En producción detrás
# de nginx y con el flag en 0, TODOS los accesos se graban con la IP del proxy
# (127.0.0.1) y la pantalla no puede mostrar de dónde se conecta cada usuario.
TRUST_PROXY_HEADERS=0
# Servicio de geolocalización por IP para la consola de Accesos. El default es
# ipwho.is (gratis, HTTPS, sin API key). El {ip} se reemplaza por la IP a
# resolver. Cada IP se consulta una sola vez y se cachea 30 días en la tabla
# IpGeo; si el servicio no responde, la pantalla igual funciona mostrando la IP.
IP_GEO_ENDPOINT=https://ipwho.is/{ip}
# Contraseñas del seed (prisma/seed.ts). Si no se setean, usa defaults de demo.
# El seed se niega a correr con NODE_ENV=production salvo SEED_ALLOW_PRODUCTION=1.
SEED_ADMIN_PASSWORD=
SEED_ALLOW_PRODUCTION=0
