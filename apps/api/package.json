{
  "name": "@pms-saas/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm exec nodemon --exec \"tsx src/server.ts\" --ext ts,json --watch src",
    "start": "pnpm exec tsx src/server.ts",
    "build": "pnpm exec tsc --project tsconfig.json",
    "typecheck": "pnpm exec tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.89.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@types/pdfkit": "^0.17.6",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "nodemon": "^3.1.14"
  }
}
